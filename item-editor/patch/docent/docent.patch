+def _extract_json_object(text: str) -> str:
+    """Best-effort extraction of a JSON object from raw LLM output."""
+    if not text:
+        return text
+    text = text.strip()
+    start = text.find("{")
+    end = text.rfind("}")
+    if start != -1 and end != -1 and end >= start:
+        text = text[start : end + 1]
+    return text.strip()
+
